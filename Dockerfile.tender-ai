FROM python:3.13.7-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TENDER_AI_DATABASE_PATH=/app/data/tenders.sqlite3 \
    TENDER_AI_TRACE_PATH=/app/artifacts/tender-ai-traces.jsonl

WORKDIR /app
COPY requirements-ai.txt ./
RUN pip install --no-cache-dir --requirement requirements-ai.txt \
    && addgroup --system tender \
    && adduser --system --ingroup tender --home /app tender \
    && mkdir -p /app/data /app/artifacts \
    && chown -R tender:tender /app

COPY --chown=tender:tender tender_ai ./tender_ai
USER tender
EXPOSE 8099
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8099/health', timeout=3)"]
CMD ["python", "-m", "uvicorn", "tender_ai.server:app", "--host", "0.0.0.0", "--port", "8099"]
